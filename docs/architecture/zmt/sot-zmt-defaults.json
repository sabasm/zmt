  "notes": {
    "pixel_units": "All 'px' values refer to CSS pixels (device-independent pixels), not physical display pixels. On high-DPI displays (Retina, etc.), 1 CSS px = multiple physical pixels.",
    "angular_sizing": "For glasses_microdisplay and ar_vr, angular size (degrees) is used instead of pixels because the physical distance between user and UI varies. Angular size ensures consistent visual and motor difficulty.",
    "density_modes": "Ultra-compact mode requires invisible hit-slop padding to compensate for reduced visual spacing. Without hit-slop, ultra-compact is prohibited.",
    "enforcement_override": "Individual surfaces can override enforcement thresholds via ADR. Use sparingly and with expiry date."
  },
  "references": {
    "wcag_2_1": "https://www.w3.org/WAI/WCAG21/quickref/",
