  "enforcement_config": {
    "modes": {
      "strict": {
        "description": "Fail CI if any violation with severity >= Alta",
        "fail_on_blocker": true,
        "fail_on_alta": true,
        "fail_on_media": false,
        "fail_on_baja": false
      },
      "audit": {
        "description": "Report violations as warnings; do not fail CI",
        "fail_on_blocker": false,
        "fail_on_alta": false,
        "fail_on_media": false,
        "fail_on_baja": false
      },
      "progressive": {
        "description": "Fail only on blockers; warn on Alta+",
        "fail_on_blocker": true,
        "fail_on_alta": false,
        "fail_on_media": false,
        "fail_on_baja": false
      }
    },
